{
  "manifest_version": 3,
  "name": "Tab Image Reaper",
  "version": "0.1.0",
  "description": "Save matching images from open tabs and close those tabs.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tab Image Reaper"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
